<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="swarm_two_lane">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode><solver><type>quick</type><iters>20</iters></solver></ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene><ambient>0.4 0.4 0.4 1</ambient><shadows>false</shadows></scene>

    <!-- 50 m x 24 m deterministic arena. UAV start lanes are y=-3 and y=3. -->
    <model name="north_wall"><static>true</static><pose>20 12 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>50 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>50 0.3 3</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>20 -12 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>50 0.3 3</size></box></geometry></collision><visual name="v"><geometry><box><size>50 0.3 3</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-5 0 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.3 24 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 24 3</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>45 0 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.3 24 3</size></box></geometry></collision><visual name="v"><geometry><box><size>0.3 24 3</size></box></geometry></visual></link></model>

    <model name="lane_divider_a"><static>true</static><pose>10 0 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.5 2.5</size></box></geometry></visual></link></model>
    <model name="lane_divider_b"><static>true</static><pose>30 0 1.25 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10 0.5 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.5 2.5</size></box></geometry></visual></link></model>
    <model name="north_obstacle"><static>true</static><pose>21 5 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 4 3</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 4 3</size></box></geometry></visual></link></model>
    <model name="south_obstacle"><static>true</static><pose>21 -5 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 4 3</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 4 3</size></box></geometry></visual></link></model>
    <model name="shared_landmark"><static>true</static><pose>20 0 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.7</radius><length>3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.7</radius><length>3</length></cylinder></geometry></visual></link></model>
  </world>
</sdf>
